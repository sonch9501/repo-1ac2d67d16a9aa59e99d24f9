{
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
      "ADO_PAT": {
        "type": "SecureString"
      }
    },
    "triggers": {
      "When_an_HTTP_request_is_received": {
        "type": "Request",
        "kind": "Http",
        "inputs": {
          "schema": {}
        }
      }
    },
    "actions": {
      "Create_RNA_Service_Request": {
        "runAfter": {},
        "type": "Http",
        "inputs": {
          "method": "POST",
          "uri": "https://dev.azure.com/YOUR_ORGANIZATION/YOUR_PROJECT/_apis/wit/workitems/$RNA%20Service%20Request?api-version=7.1",
          "headers": {
            "Authorization": "@{concat('Basic ', base64(concat(':', parameters('ADO_PAT'))))}",
            "Content-Type": "application/json-patch+json"
          },
          "body": [
            {
              "op": "add",
              "path": "/fields/System.Title",
              "value": "test"
            },
            {
              "op": "add",
              "path": "/fields/System.State",
              "value": "New"
            },
            {
              "op": "add",
              "path": "/fields/System.AreaPath",
              "value": "YOUR_PROJECT"
            },
            {
              "op": "add",
              "path": "/fields/System.IterationPath",
              "value": "YOUR_PROJECT"
            },
            {
              "op": "add",
              "path": "/fields/System.Description",
              "value": "test"
            },
            {
              "op": "add",
              "path": "/fields/Custom.Classification",
              "value": "test"
            },
            {
              "op": "add",
              "path": "/fields/Custom.SRRequestor",
              "value": "test"
            },
            {
              "op": "add",
              "path": "/fields/Microsoft.VSTS.Scheduling.DueDate",
              "value": "@{formatDateTime(addDays(convertTimeZone(utcNow(),'UTC','Tokyo Standard Time'),1),'yyyy-MM-dd')}"
            },
            {
              "op": "add",
              "path": "/fields/Custom.Environment",
              "value": "test"
            },
            {
              "op": "add",
              "path": "/fields/Microsoft.VSTS.Common.Priority",
              "value": 2
            },
            {
              "op": "add",
              "path": "/fields/Custom.RequestType",
              "value": "test"
            },
            {
              "op": "add",
              "path": "/fields/Custom.RequestCategory",
              "value": "test"
            }
          ]
        }
      }
    },
    "outputs": {}
  },
  "parameters": {
    "ADO_PAT": {
      "value": "YOUR_PAT"
    }
  }
}
